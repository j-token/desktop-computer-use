# Copy to .env in this skill directory. Existing environment variables win.
# The LLM is the harness running this skill. No separate LLM API key is needed.
# Modes: llm (default), llm+jev.
DCU_AGENT_MODE=llm

# Optional accelerator for llm+jev; the harness handles planning and text.
TYPESAFE_API_KEY=
DCU_JEV_BASE_URL=https://api.typesafe.ai/v1
DCU_JEV_MODEL=jev-latest
DCU_JEV_TIMEOUT_MS=8000
