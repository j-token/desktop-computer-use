      <default>['Escape', '&lt;Shift&gt;Escape', '&lt;Control&gt;Escape', '&lt;Shift&gt;&lt;Control&gt;Escape', '&lt;Alt&gt;Escape', '&lt;Shift&gt;&lt;Alt&gt;Escape', '&lt;Control&gt;&lt;Alt&gt;Escape', '&lt;Shift&gt;&lt;Control&gt;&lt;Alt&gt;Escape', '&lt;Super&gt;Escape', '&lt;Shift&gt;&lt;Super&gt;Escape', '&lt;Control&gt;&lt;Super&gt;Escape', '&lt;Shift&gt;&lt;Control&gt;&lt;Super&gt;Escape', '&lt;Alt&gt;&lt;Super&gt;Escape', '&lt;Shift&gt;&lt;Alt&gt;&lt;Super&gt;Escape', '&lt;Control&gt;&lt;Alt&gt;&lt;Super&gt;Escape', '&lt;Shift&gt;&lt;Control&gt;&lt;Alt&gt;&lt;Super&gt;Escape']</default>
